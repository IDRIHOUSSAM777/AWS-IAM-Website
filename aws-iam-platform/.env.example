# KYUBI — Google Gemini
# Create a key at https://aistudio.google.com/apikey
# Server-side only: this value is never sent to the browser.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (fast chat replies).
# gemini-2.5-flash also works; gemini-3.5-flash is noticeably slower.
GEMINI_MODEL=gemini-3.5-flash-lite
