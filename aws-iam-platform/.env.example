# KYUBI — Google Gemini
# Create a key at https://aistudio.google.com/apikey
# Server-side only: this value is never sent to the browser.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite (fast chat replies).
# gemini-2.5-flash also works; gemini-3.5-flash is noticeably slower.
GEMINI_MODEL=gemini-3.5-flash-lite

# Saved names (landing page) - MariaDB/MySQL.
# Create the database with database/schema.sql, then fill these in.
# Server-side only. Restart "npm run dev" after changing them.
DB_HOST=192.168.59.128
DB_PORT=3306
DB_USER=aws
DB_PASSWORD=
DB_NAME=aws_iam_platform
